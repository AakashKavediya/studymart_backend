# =============================================================================
# StudyMart Backend - Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# Never commit the .env file containing real secrets to version control.

# -----------------------------------------------------------------------------
# 1. Application & Server Settings
# -----------------------------------------------------------------------------
# Environment mode: 'development' or 'production' (Affects cookie security & SameSite)
APP_ENV=production
APP_NAME=StudyMart_Backend
PORT=8000
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://studybazar.vercel.app
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. Security & Authentication (MANDATORY)
# -----------------------------------------------------------------------------
# A strong random secret key for JWT signing (e.g. generate via: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 3. Database Configuration (MANDATORY)
# -----------------------------------------------------------------------------
# MongoDB connection URI (MongoDB Atlas or standalone cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://db_user:db_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=study-mart

# -----------------------------------------------------------------------------
# 4. Google OAuth2 (Required for Google Sign-In)
# -----------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_project_id

# -----------------------------------------------------------------------------
# 5. Media & File Storage (Cloudinary - Used for image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 6. CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated or regex-allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://studybazar.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# -----------------------------------------------------------------------------
# 7. Email / SMTP Settings (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_NAME="StudyMart Support"
SMTP_FROM_EMAIL=no-reply@studymart.com
SMTP_USE_TLS=True
